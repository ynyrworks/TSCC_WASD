<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows SDK projection for the WinRT Bluetooth LE API (NS2 Pro over Bluetooth); runs on Windows 10 2004+. -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned driver installers; scripts/package.ps1 reads the same file. -->
    <EmbeddedResource Include="drivers.json" LogicalName="TSCC_WASD.Core.drivers.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TSCC_WASD.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
  </ItemGroup>

</Project>
