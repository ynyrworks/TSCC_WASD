<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TSCC_WASD.Core\TSCC_WASD.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The program is TSCC_WASD.exe; the project keeps the .App suffix next to Core and Tests. -->
    <AssemblyName>TSCC_WASD</AssemblyName>
    <!-- Same Windows target as TSCC_WASD.Core (WinRT Bluetooth LE). -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms only for the notification-area icon; keep its types out of the global namespace. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\TSCC_WASD.ico</ApplicationIcon>
    <!-- Release ZIPs are self-contained (no separate .NET install); restore needs the RID for the lock file. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="Assets\TSCC_WASD.ico" />
  </ItemGroup>

</Project>
