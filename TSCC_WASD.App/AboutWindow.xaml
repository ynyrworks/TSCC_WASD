<Window x:Class="TSCC_WASD.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:TSCC_WASD.App"
        Title="{app:T Zh='關於 TSCC_WASD', En='About TSCC_WASD'}" Icon="Assets/TSCC_WASD.ico"
        Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary Source="Themes/Dark.xaml"/>
    </Window.Resources>
    <StackPanel Margin="24">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Image Source="Assets/TSCC_WASD.ico" Width="48" Height="48" Margin="0,0,14,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="TSCC_WASD" FontSize="22" FontWeight="Bold"/>
                <TextBlock x:Name="VersionText" Style="{StaticResource Muted}"/>
            </StackPanel>
        </StackPanel>
        <TextBlock Margin="0,0,0,10"
                   Text="{app:T Zh='讓遊戲把 Xbox 或 Nintendo Switch 2 Pro 手把當成 DualShock 4，顯示 PS 按鍵圖示。', En='Makes games see an Xbox or Nintendo Switch 2 Pro controller as a DualShock 4, so they show PS prompts.'}"/>
        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16"
                   Text="{app:T Zh='TSCC＝Triangle、Square、Cross、Circle（三角形、正方形、叉叉、圓形）。', En='TSCC = Triangle, Square, Cross, Circle.'}"/>
        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4"
                   Text="{app:T Zh='MIT 授權開源。NS2 Pro 協定部分改作自 SDL（zlib 授權）。使用 ViGEmBus 與 HidHide（另行安裝）。', En='Open source under the MIT License. NS2 Pro protocol portions are adapted from SDL (zlib). Uses ViGEmBus and HidHide (installed separately).'}"/>
        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16"
                   Text="{app:T Zh='PlayStation、DualShock、Xbox、Nintendo Switch、Steam 為各自所有者的商標，本專案與其無關聯。', En='PlayStation, DualShock, Xbox, Nintendo Switch and Steam are trademarks of their owners; this project is not affiliated with them.'}"/>
        <WrapPanel Margin="0,0,0,8">
            <Button Content="GitHub" Click="OnOpen" Tag="https://github.com/ynyrworks/TSCC_WASD"/>
            <Button Content="{app:T Zh=第三方聲明, En='Third-party notices'}" Click="OnOpen"
                    Tag="https://github.com/ynyrworks/TSCC_WASD/blob/main/THIRD-PARTY-NOTICES.md"/>
            <Button Content="{app:T Zh=回報問題, En='Report an issue'}" Click="OnOpen" Tag="https://github.com/ynyrworks/TSCC_WASD/issues"/>
        </WrapPanel>
        <WrapPanel Margin="0,0,0,16">
            <Button Content="{app:T Zh=複製診斷資訊, En='Copy diagnostics'}" Command="{Binding CopyDiagnosticsCommand}"
                    ToolTip="{app:T Zh='版本、驅動程式與手把狀態，貼到問題回報中', En='Versions, drivers and controller state, for a bug report'}"/>
            <Button Content="{app:T Zh=開啟日誌資料夾, En='Open log folder'}" Command="{Binding OpenLogsCommand}"/>
        </WrapPanel>
        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8"
                   Text="{app:T Zh='TSCC_WASD 免費且開源。如果它幫上忙，歡迎請作者喝杯咖啡。', En='TSCC_WASD is free and open source. If it helps you, you can buy the author a coffee.'}"/>
        <Button Content="{app:T Zh='☕ 在 Ko-fi 支持', En='☕ Support on Ko-fi'}" Command="{Binding SupportCommand}"
                HorizontalAlignment="Left" Margin="0,0,0,16"/>
        <Button Content="{app:T Zh=關閉, En=Close}" IsCancel="True" IsDefault="True" HorizontalAlignment="Right"
                Style="{StaticResource PrimaryButton}" Margin="0" Click="OnClose"/>
    </StackPanel>
</Window>
