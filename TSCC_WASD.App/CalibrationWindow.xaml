<ui:FluentWindow x:Class="TSCC_WASD.App.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:app="clr-namespace:TSCC_WASD.App"
        Icon="Assets/TSCC_WASD.ico" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Window.Resources>
        <ResourceDictionary Source="Themes/Shell.xaml"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ui:TitleBar x:Name="WindowTitleBar" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="Assets/TSCC_WASD.ico"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>
    <StackPanel Grid.Row="1" Margin="24,8,24,24">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock x:Name="StepTitle" Style="{StaticResource PageTitle}" FontSize="18" Margin="0"/>
            <app:HelpTip Key="calib.steps"/>
        </StackPanel>
        <TextBlock x:Name="StepText" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,16"/>
        <Grid x:Name="RangePanel" Visibility="Collapsed" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{app:T Zh=左搖桿, En='Left stick'}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="{app:T Zh=右, En=Right}" FontSize="12"/><ProgressBar x:Name="L0" Minimum="0" Maximum="1" Margin="0,2,0,6"/>
                <TextBlock Text="{app:T Zh=左, En=Left}" FontSize="12"/><ProgressBar x:Name="L1" Minimum="0" Maximum="1" Margin="0,2,0,6"/>
                <TextBlock Text="{app:T Zh=上, En=Up}" FontSize="12"/><ProgressBar x:Name="L2" Minimum="0" Maximum="1" Margin="0,2,0,6"/>
                <TextBlock Text="{app:T Zh=下, En=Down}" FontSize="12"/><ProgressBar x:Name="L3" Minimum="0" Maximum="1" Margin="0,2,0,6"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="{app:T Zh=右搖桿, En='Right stick'}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="{app:T Zh=右, En=Right}" FontSize="12"/><ProgressBar x:Name="R0" Minimum="0" Maximum="1" Margin="0,2,0,6"/>
                <TextBlock Text="{app:T Zh=左, En=Left}" FontSize="12"/><ProgressBar x:Name="R1" Minimum="0" Maximum="1" Margin="0,2,0,6"/>
                <TextBlock Text="{app:T Zh=上, En=Up}" FontSize="12"/><ProgressBar x:Name="R2" Minimum="0" Maximum="1" Margin="0,2,0,6"/>
                <TextBlock Text="{app:T Zh=下, En=Down}" FontSize="12"/><ProgressBar x:Name="R3" Minimum="0" Maximum="1" Margin="0,2,0,6"/>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="CenterWarn" Visibility="Collapsed" TextWrapping="Wrap" Foreground="OrangeRed" Margin="0,0,0,8"
                   Text="{app:T Zh=搖桿沒有放開或手把沒有送資料，請放開搖桿並等一下再試一次, En='The sticks were not released or the controller sent no steady data. Let go of the sticks, wait a moment and try again.'}"/>
        <TextBlock x:Name="NoReportWarn" Visibility="Collapsed" TextWrapping="Wrap" Foreground="OrangeRed" Margin="0,0,0,8"
                   Text="{app:T Zh=手把沒有送出資料，請確認手把已連接且電量足夠, En='The controller is not sending data. Check that it is connected and charged.'}"/>
        <TextBlock x:Name="RawText" Style="{StaticResource Muted}" Margin="0,0,0,16"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button x:Name="ResetButton" app:HelpTip.Key="calib.reset" Margin="0" Content="{app:T Zh=清除校準, En='Clear calibration'}" Click="OnReset"/>
            <app:HelpTip Key="calib.reset" Margin="2,0,12,0"/>
            <ui:Button x:Name="CancelButton" Margin="0,0,8,0" Content="{app:T Zh=取消, En=Cancel}" IsCancel="True" Click="OnCancel"/>
            <ui:Button x:Name="NextButton" app:HelpTip.Key="calib.steps" Appearance="Primary" Margin="0" IsDefault="True" Click="OnNext"/>
        </StackPanel>
    </StackPanel>
    </Grid>
</ui:FluentWindow>
