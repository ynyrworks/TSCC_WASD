<ui:FluentWindow x:Class="TSCC_WASD.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:app="clr-namespace:TSCC_WASD.App"
        xmlns:pages="clr-namespace:TSCC_WASD.App.Pages"
        Title="TSCC_WASD" Icon="Assets/TSCC_WASD.ico" Width="960" Height="600"
        MinWidth="720" MinHeight="480" WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <ui:TitleBar Title="TSCC_WASD">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="Assets/TSCC_WASD.ico"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <!-- Pages share the window's MainViewModel; MainWindow.xaml.cs hands it to each page. -->
        <ui:NavigationView x:Name="RootNavigation" Grid.Row="1" PaneDisplayMode="Left" OpenPaneLength="200"
                           IsBackButtonVisible="Collapsed" IsPaneToggleVisible="False">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{app:T Zh=首頁, En=Home}" TargetPageType="{x:Type pages:HomePage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Home24"/></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{app:T Zh=設定檔, En=Profiles}" TargetPageType="{x:Type pages:ProfilesPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Games24"/></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{app:T Zh=程式設定, En='App settings'}" TargetPageType="{x:Type pages:SettingsPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Settings24"/></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{app:T Zh=關於與說明, En='About &amp; help'}" TargetPageType="{x:Type pages:AboutPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Info24"/></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
