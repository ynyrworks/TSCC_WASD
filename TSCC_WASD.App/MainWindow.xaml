<Window x:Class="TSCC_WASD.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:TSCC_WASD.App"
        Title="TSCC_WASD" Icon="Assets/TSCC_WASD.ico" Width="900" Height="760"
        MinWidth="720" MinHeight="560" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary Source="Themes/Dark.xaml"/>
    </Window.Resources>
    <DockPanel>
        <!-- Header: name on the left, help / updates / about on the right. -->
        <Grid DockPanel.Dock="Top" Margin="24,20,24,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Image Source="Assets/TSCC_WASD.ico" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="TSCC_WASD" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="8,0,0,4"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Muted}" FontSize="13"
                           Text="{app:T Zh='把 Xbox／NS2 Pro 手把變成 DualShock 4，讓遊戲顯示 PS 按鍵', En='Turns an Xbox or NS2 Pro controller into a DualShock 4 so games show PS prompts'}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource LinkButton}" Content="{app:T Zh=使用說明, En=Help}" Command="{Binding OpenHelpCommand}"/>
                <Button Style="{StaticResource LinkButton}" Content="{app:T Zh=檢查更新, En='Check for updates'}" Command="{Binding CheckUpdatesCommand}"/>
                <Button Style="{StaticResource LinkButton}" Content="{app:T Zh=關於, En=About}" Command="{Binding AboutCommand}"/>
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,0,24,24">
                <!-- Status card: everything needed day to day. -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse Width="12" Height="12" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource IdleBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusTitle}" FontSize="20" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" Margin="0,0,0,4" AutomationProperties.LiveSetting="Polite"/>
                        <!-- Update download progress; only shown while an update downloads. -->
                        <Grid Margin="0,4,0,8">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDownloadingUpdate}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding UpdateProgressText}" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                <ProgressBar Value="{Binding UpdateProgress, Mode=OneWay}" Minimum="0" Maximum="1" Height="6"
                                             Foreground="{StaticResource AccentBrush}" Background="{StaticResource RaisedBrush}" BorderThickness="0"
                                             AutomationProperties.Name="{app:T Zh=更新下載進度, En='Update download progress'}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="{app:T Zh=取消, En=Cancel}" Command="{Binding CancelUpdateCommand}"
                                    Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding InputSummary}" Style="{StaticResource Muted}" Margin="0,0,0,16"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name"
                                      IsEnabled="{Binding CanEdit}" Margin="0,0,12,8" VerticalAlignment="Top"
                                      AutomationProperties.Name="{app:T Zh=設定檔, En=Profile}"/>
                            <WrapPanel Grid.Column="1">
                                <Button Style="{StaticResource PrimaryButton}" Content="{app:T Zh=啟動映射, En='Start mapping'}" Command="{Binding StartCommand}"/>
                                <Button Content="{Binding PauseButtonText}" Command="{Binding PauseCommand}"
                                        ToolTip="{app:T Zh='遊戲看到放開所有按鍵的虛擬 DS4；實體手把仍隱藏，繼續時不必處理 Steam', En='Games see a virtual DS4 with nothing pressed; controllers stay hidden, so resuming needs nothing from Steam'}"/>
                                <Button Content="{app:T Zh=停止, En=Stop}" Command="{Binding StopCommand}"
                                        ToolTip="{app:T Zh='完全釋放：關閉虛擬 DS4，實體手把恢復可見', En='Release everything: remove the virtual DS4 and show the physical controllers again'}"/>
                                <Button Content="{app:T Zh='重新啟動 Steam', En='Restart Steam'}" Command="{Binding RestartSteamCommand}"
                                        ToolTip="{app:T Zh='讓 Steam 只看到虛擬 DS4（映射中才可使用）', En='Make Steam see only the virtual DS4 (while mapping)'}"/>
                            </WrapPanel>
                        </Grid>
                        <DockPanel Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{app:T Zh=安裝驅動程式, En='Install drivers'}"
                                    Command="{Binding InstallDepsCommand}"/>
                            <TextBlock Text="{Binding DependencyStatus}" Style="{StaticResource Muted}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Profile details, collapsed by default. -->
                <Expander>
                    <Expander.Header>
                        <StackPanel>
                            <TextBlock Text="{app:T Zh=設定檔與手把, En='Profile and controller'}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Muted}" Text="{app:T Zh='輸入手把、隱藏實體手把、震動、死區、搖桿校準', En='Input, hiding, rumble, dead zone, stick calibration'}"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <StackPanel IsEnabled="{Binding CanEdit}">
                            <TextBlock Style="{StaticResource Label}" Text="{app:T Zh=輸入手把, En='Input controller'}"/>
                            <ComboBox ItemsSource="{Binding InputOptions}" DisplayMemberPath="Name" SelectedValuePath="Type"
                                      SelectedValue="{Binding SelectedProfile.InputType, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="{app:T Zh=輸入手把, En='Input controller'}"/>
                            <TextBlock Style="{StaticResource Label}" Text="{app:T Zh=輸出成, En='Output as'}"/>
                            <ComboBox ItemsSource="{Binding OutputOptions}" DisplayMemberPath="Name" SelectedValuePath="Type"
                                      SelectedValue="{Binding SelectedProfile.OutputType, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="{app:T Zh=輸出成, En='Output as'}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{app:T Zh='遊戲顯示哪種按鍵圖示取決於它看到的手把。Xbox 360 相容性最好；DualShock 4 才有 PS 圖示、PS 鍵、觸控板與體感。映射中切換會立即生效。', En='Games pick prompts from the controller they see. Xbox 360 is the most compatible; only DualShock 4 gives PS prompts, the PS button, touchpad and motion. Switching applies right away while mapping.'}"/>
                            <CheckBox IsChecked="{Binding SelectedProfile.SwapFaceButtons}"
                                      Content="{app:T Zh='對調 A/B 與 X/Y（任天堂習慣：右邊的鍵是確認）', En='Swap A/B and X/Y (Nintendo habit: the right-hand button confirms)'}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{app:T Zh='勾選後右側鍵送出 ✕／Xbox A、下方鍵送出 ○／Xbox B。NS2 Pro 也會改成依按鍵上的字母對應，而不是位置。', En='The right-hand button then sends Cross / Xbox A and the bottom one Circle / Xbox B. The NS2 Pro then follows the letters printed on its buttons instead of their positions.'}"/>
                            <CheckBox IsChecked="{Binding SelectedProfile.HidePhysicalControllers}"
                                      Content="{app:T Zh='映射時自動隱藏實體手把（需 HidHide）', En='Hide physical controllers while mapping (needs HidHide)'}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{app:T Zh='讓遊戲只看到虛擬 DS4，避免按鍵圖示在 Xbox／PS 之間跳動。請先啟動映射再開遊戲；停止映射後自動還原。', En='Games then only see the virtual DS4, so prompts stop flipping between Xbox and PS. Start mapping before the game; stopping restores everything.'}"/>
                            <CheckBox IsChecked="{Binding SelectedProfile.ForwardRumble}"
                                      Content="{app:T Zh=把遊戲震動轉給實體手把, En='Forward game rumble to the physical controller'}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{app:T Zh='Xbox 鍵與 NS2 Home 鍵對應 PS 鍵、NS2 截圖鍵對應觸控板按下；NS2 陀螺儀會轉成 DS4 體感。', En='Xbox Guide and NS2 Home map to PS, NS2 Capture to touchpad click, and the NS2 gyro becomes DS4 motion.'}"/>
                            <CheckBox IsChecked="{Binding SelectedProfile.XboxBackAsTouchpad}"
                                      Content="{app:T Zh='Xbox 的 View（Back）鍵當作觸控板按下', En='Use the Xbox View (Back) button as the touchpad click'}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{app:T Zh='PS 遊戲常用觸控板開地圖或選單。取消勾選則 View 鍵送出 Share；NS2 Pro 不受影響（－鍵是 Share、截圖鍵是觸控板）。', En='PS games often open the map or menu with the touchpad. Unchecked, View sends Share. The NS2 Pro is unaffected (Minus is Share, Capture is the touchpad).'}"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Label}" Text="{app:T Zh=設定檔名稱, En='Profile name'}"/>
                                    <TextBox Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                                             AutomationProperties.Name="{app:T Zh=設定檔名稱, En='Profile name'}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Label}" Text="{app:T Zh=說明, En=Description}"/>
                                    <TextBox Text="{Binding SelectedProfile.Description, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{app:T Zh=設定檔說明, En='Profile description'}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource Label}" Text="{app:T Zh='搖桿死區（0–0.95）', En='Stick dead zone (0–0.95)'}"/>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Right" Width="48" TextAlignment="Right" Text="{Binding SelectedProfile.DeadZone, StringFormat=F2}"/>
                                <Slider Minimum="0" Maximum="0.95" TickFrequency="0.01" IsSnapToTickEnabled="True"
                                        Value="{Binding SelectedProfile.DeadZone}" AutomationProperties.Name="{app:T Zh=搖桿死區, En='Dead zone'}"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Label}" Text="{app:T Zh='目標輪詢頻率（30–500 Hz）', En='Target polling rate (30–500 Hz)'}"/>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Right" Width="48" TextAlignment="Right" Text="{Binding SelectedProfile.PollingRateHz}"/>
                                <Slider Minimum="30" Maximum="500" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding SelectedProfile.PollingRateHz}" AutomationProperties.Name="{app:T Zh=輪詢頻率, En='Polling rate'}"/>
                            </DockPanel>
                        </StackPanel>
                        <Button Content="{app:T Zh='校準 NS2 Pro 搖桿', En='Calibrate NS2 Pro sticks'}" Command="{Binding CalibrateCommand}"
                                HorizontalAlignment="Left" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16"
                                   Text="{app:T Zh='推到底卻只像輕推、或放開時會飄移時使用；映射中也可以校準，儲存後立即套用。', En='Use this if a full push feels like a light one or the stick drifts at rest. Works while mapping; applies as soon as you save.'}"/>
                        <WrapPanel>
                            <Button Style="{StaticResource PrimaryButton}" Content="{app:T Zh=儲存全部, En='Save all'}" Command="{Binding SaveCommand}"/>
                            <Button Content="{app:T Zh=新增, En=New}" Command="{Binding NewCommand}"/>
                            <Button Content="{app:T Zh=移除, En=Remove}" Command="{Binding DeleteCommand}"/>
                            <Button Content="{app:T Zh=匯入, En=Import}" Command="{Binding ImportCommand}"/>
                            <Button Content="{app:T Zh=匯出全部, En='Export all'}" Command="{Binding ExportCommand}"/>
                            <Button Content="{app:T Zh=重新載入, En=Reload}" Command="{Binding ReloadCommand}"/>
                            <Button Content="{app:T Zh=設定資料夾, En='Settings folder'}" Command="{Binding OpenProfilesCommand}"/>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Muted}"
                                   Text="{app:T Zh='映射中的修改與切換設定檔會立即套用，不必停止映射。按「儲存全部」才會寫入磁碟；重新載入或關閉會捨棄未儲存的修改。', En='Edits and profile switches apply immediately while mapping; no need to stop. Click Save all to write them to disk; reloading or closing discards unsaved changes.'}"/>
                    </StackPanel>
                </Expander>

                <!-- App-wide settings, collapsed by default. -->
                <Expander>
                    <Expander.Header>
                        <StackPanel>
                            <TextBlock Text="{app:T Zh=程式設定, En='App settings'}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Muted}" Text="{app:T Zh='開機啟動、Steam、系統匣、語言、更新', En='Startup, Steam, tray, language, updates'}"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <CheckBox IsChecked="{Binding StartWithWindows}"
                                  Content="{app:T Zh=登入 Windows 時自動啟動並開始映射, En='Start with Windows and begin mapping'}"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="{app:T Zh='開機後縮在系統匣直接映射，搭配下面兩項就不必再手動重啟 Steam。', En='Runs in the notification area right after sign-in. With the two Steam options below you never need to restart Steam by hand.'}"/>
                        <CheckBox IsChecked="{Binding StartMappingOnLaunch}"
                                  Content="{app:T Zh=每次開啟程式就自動開始映射, En='Begin mapping whenever the app opens'}"/>
                        <CheckBox IsChecked="{Binding ManageSteam}"
                                  Content="{app:T Zh=自動開始映射時，若 Steam 已先開啟就自動重啟它, En='On automatic start, restart Steam if it started first'}"/>
                        <CheckBox IsChecked="{Binding LaunchSteamAfterAutoStart}"
                                  Content="{app:T Zh=自動開始映射後啟動 Steam, En='Launch Steam after an automatic start'}"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="{app:T Zh='建議同時在 Steam 設定關閉「電腦開機時執行 Steam」，讓 Steam 一律在隱藏手把之後才啟動。', En='Also turn off Steam’s own “Run Steam when my computer starts” so Steam always starts after the controllers are hidden.'}"/>
                        <TextBlock Style="{StaticResource Label}" Text="{app:T Zh=自動重新連接（不必重啟 Steam）, En='Automatic reconnect (no Steam restart)'}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding ReconnectHelperStatus}"/>
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="{app:T Zh=設定自動重新連接, En='Set up automatic reconnect'}" Command="{Binding SetupReconnectCommand}"
                                    ToolTip="{app:T Zh='需要一次管理員權限；之後 Steam 握著 USB 手把時會自動重新連接，不必重啟 Steam', En='Needs administrator rights once; afterwards USB controllers held by Steam are reconnected instead of restarting Steam'}"/>
                            <Button Content="{app:T Zh=移除, En=Remove}" Command="{Binding RemoveReconnectCommand}"/>
                        </WrapPanel>
                        <CheckBox IsChecked="{Binding MinimizeToTray}"
                                  Content="{app:T Zh=最小化時縮到系統匣, En='Minimize to the notification area'}"/>
                        <CheckBox IsChecked="{Binding CheckUpdatesOnStartup}"
                                  Content="{app:T Zh=開啟程式時檢查更新, En='Check for updates when the app opens'}"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="{app:T Zh='只會連到 GitHub 查詢最新版本；沒勾選時，只有按「檢查更新」才會連網。', En='Only contacts GitHub for the latest version; otherwise the network is used only when you click Check for updates.'}"/>
                        <TextBlock Style="{StaticResource Label}" Text="{app:T Zh='語言（重新開啟後套用）', En='Language (applies after restart)'}"/>
                        <ComboBox ItemsSource="{Binding LanguageOptions}" DisplayMemberPath="Name" SelectedValuePath="Code"
                                  SelectedValue="{Binding Language}" Width="220" HorizontalAlignment="Left" Margin="0"
                                  AutomationProperties.Name="{app:T Zh=語言, En=Language}"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
