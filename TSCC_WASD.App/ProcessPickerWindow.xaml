<Window x:Class="TSCC_WASD.App.ProcessPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:TSCC_WASD.App"
        Title="{app:T Zh='從執行中的程式挑選', En='Pick from running programs'}"
        Icon="Assets/TSCC_WASD.ico" Width="520" Height="480" MinWidth="360" MinHeight="300"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary Source="Themes/Dark.xaml"/>
    </Window.Resources>
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Label}" Text="{app:T Zh=篩選, En=Filter}"/>
        <TextBox x:Name="FilterBox" DockPanel.Dock="Top" Margin="0,0,0,8" TextChanged="OnFilterChanged"
                 AutomationProperties.Name="{app:T Zh=篩選, En=Filter}"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <StackPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Margin" Value="0,0,8,0"/>
                </Style>
            </StackPanel.Resources>
            <Button Content="{app:T Zh=取消, En=Cancel}" IsCancel="True"/>
            <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" Margin="0" IsDefault="True" IsEnabled="False"
                    Content="{app:T Zh=選擇, En=Select}" Click="OnOk"/>
        </StackPanel>
        <ListBox x:Name="ProcessList" Foreground="{StaticResource TextBrush}" Background="{StaticResource RaisedBrush}" SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnDoubleClick"
                 AutomationProperties.Name="{app:T Zh=執行中的程式, En='Running programs'}"/>
    </DockPanel>
</Window>
