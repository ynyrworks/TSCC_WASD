<ui:FluentWindow x:Class="TSCC_WASD.App.ProcessPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:app="clr-namespace:TSCC_WASD.App"
        Title="{app:T Zh='從執行中的程式挑選', En='Pick from running programs'}"
        Icon="Assets/TSCC_WASD.ico" Width="520" Height="480" MinWidth="360" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Window.Resources>
        <ResourceDictionary Source="Themes/Shell.xaml"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <ui:TitleBar Title="{app:T Zh='從執行中的程式挑選', En='Pick from running programs'}" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="Assets/TSCC_WASD.ico"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>
    <DockPanel Grid.Row="1" Margin="24,8,24,24">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Label}" Text="{app:T Zh=篩選, En=Filter}"/>
        <ui:TextBox x:Name="FilterBox" DockPanel.Dock="Top" Margin="0,0,0,8" TextChanged="OnFilterChanged"
                 AutomationProperties.Name="{app:T Zh=篩選, En=Filter}"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <ui:Button Margin="0,0,8,0" Content="{app:T Zh=取消, En=Cancel}" IsCancel="True"/>
            <ui:Button x:Name="OkButton" Appearance="Primary" Margin="0" IsDefault="True" IsEnabled="False"
                    Content="{app:T Zh=選擇, En=Select}" Click="OnOk"/>
        </StackPanel>
        <ListBox x:Name="ProcessList" SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnDoubleClick"
                 AutomationProperties.Name="{app:T Zh=執行中的程式, En='Running programs'}"/>
    </DockPanel>
    </Grid>
</ui:FluentWindow>
