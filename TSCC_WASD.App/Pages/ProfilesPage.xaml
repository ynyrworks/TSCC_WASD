<Page x:Class="TSCC_WASD.App.Pages.ProfilesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:app="clr-namespace:TSCC_WASD.App"
      Title="{app:T Zh=設定檔, En='Profiles'}" Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Shell.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <app:ProfileSubtitleConverter x:Key="ProfileSubtitle"/>
        </ResourceDictionary>
    </Page.Resources>
    <!-- No ScrollViewer here: the navigation view's content presenter scrolls the whole page (list and editor together). -->
    <Grid Margin="24,8,24,24">
        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*" MinWidth="320"/></Grid.ColumnDefinitions>

        <!-- Left: the profile list -->
        <StackPanel>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitle}" Margin="0" VerticalAlignment="Center" Text="{app:T Zh=設定檔, En='Profiles'}"/>
                    <app:HelpTip Key="profiles.list"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Margin="0" Content="{app:T Zh=新增, En=New}" Command="{Binding NewCommand}"
                            AutomationProperties.Name="{app:T Zh=新增設定檔, En='New profile'}" app:HelpTip.Key="profiles.new"/>
                    <app:HelpTip Key="profiles.new" Margin="2,0,6,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:DropDownButton app:HelpTip.Key="profiles.more" DataContextChanged="OnMoreActionsDataContextChanged" Content="⋯"
                                   AutomationProperties.Name="{app:T Zh='更多：移除、複製、匯入、匯出、重新載入、設定資料夾', En='More: remove, duplicate, import, export, reload, settings folder'}">
                    <ui:DropDownButton.Flyout>
                        <ContextMenu x:Name="MoreActionsMenu">
                            <MenuItem Command="{Binding DeleteCommand}" app:HelpTip.Key="profiles.remove" AutomationProperties.Name="{app:T Zh=移除, En=Remove}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="{app:T Zh=移除, En=Remove}"/><app:HelpTip Key="profiles.remove" Focusable="False"/></StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem Command="{Binding DuplicateCommand}" app:HelpTip.Key="profiles.duplicate" AutomationProperties.Name="{app:T Zh=複製, En=Duplicate}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="{app:T Zh=複製, En=Duplicate}"/><app:HelpTip Key="profiles.duplicate" Focusable="False"/></StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Command="{Binding ImportCommand}" app:HelpTip.Key="profiles.import" AutomationProperties.Name="{app:T Zh=匯入, En=Import}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="{app:T Zh=匯入, En=Import}"/><app:HelpTip Key="profiles.import" Focusable="False"/></StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem Command="{Binding ExportCommand}" app:HelpTip.Key="profiles.export" AutomationProperties.Name="{app:T Zh=匯出全部, En='Export all'}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="{app:T Zh=匯出全部, En='Export all'}"/><app:HelpTip Key="profiles.export" Focusable="False"/></StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Command="{Binding ReloadCommand}" app:HelpTip.Key="profiles.reload" AutomationProperties.Name="{app:T Zh=從磁碟重新載入, En='Reload from disk'}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="{app:T Zh=從磁碟重新載入, En='Reload from disk'}"/><app:HelpTip Key="profiles.reload" Focusable="False"/></StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem Command="{Binding OpenProfilesCommand}" app:HelpTip.Key="profiles.folder" AutomationProperties.Name="{app:T Zh=開啟設定資料夾, En='Open settings folder'}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="{app:T Zh=開啟設定資料夾, En='Open settings folder'}"/><app:HelpTip Key="profiles.folder" Focusable="False"/></StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                        </ContextMenu>
                    </ui:DropDownButton.Flyout>
                </ui:DropDownButton>
                    <app:HelpTip Key="profiles.more" Margin="2,0,0,0"/>
                </StackPanel>
            </Grid>
            <!-- The list never scrolls on its own; the page does. -->
            <ListBox app:HelpTip.Key="profiles.list" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" IsEnabled="{Binding CanEdit}"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent"
                     AutomationProperties.Name="{app:T Zh=設定檔, En=Profiles}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,6">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource ProfileSubtitle}">
                                        <Binding Path="MatchProcessName"/>
                                        <Binding/>
                                        <Binding Path="DataContext.SelectedProfile" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                        <Binding Path="DataContext.IsRunning" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <!-- Right: the selected profile -->
        <StackPanel Grid.Column="2">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedProfile}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding SelectedProfile.Name}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                           Text="{Binding SaveStatusText}" AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SaveStatusIsSaved}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SaveStatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <StackPanel IsEnabled="{Binding CanEdit}">
                <!-- Identity and devices -->
                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Label}" Text="{app:T Zh=設定檔名稱, En='Profile name'}"/>
                                <app:HelpTip Key="profiles.name"/>
                            </StackPanel>
                            <TextBox app:HelpTip.Key="profiles.name" Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                                     AutomationProperties.Name="{app:T Zh=設定檔名稱, En='Profile name'}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Label}" Text="{app:T Zh=說明, En=Description}"/>
                                <app:HelpTip Key="profiles.description"/>
                            </StackPanel>
                            <TextBox app:HelpTip.Key="profiles.description" Text="{Binding SelectedProfile.Description, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{app:T Zh=設定檔說明, En='Profile description'}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Label}" Text="{app:T Zh=遊戲程序, En='Game process'}"/>
                                <app:HelpTip Key="profiles.process"/>
                            </StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="{app:T Zh=挑選…, En='Pick…'}" app:HelpTip.Key="profiles.process"
                                        ToolTip="{app:T Zh=從執行中的程式挑選, En='Pick from running programs'}" Command="{Binding PickProcessCommand}"/>
                                <TextBox app:HelpTip.Key="profiles.process" Text="{Binding SelectedProfile.MatchProcessName, UpdateSourceTrigger=PropertyChanged}" MaxLength="260"
                                         AutomationProperties.Name="{app:T Zh=遊戲程序名稱, En='Game process name'}"/>
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Label}" Text="{app:T Zh=輸入手把, En='Input controller'}"/>
                                <app:HelpTip Key="profiles.input"/>
                            </StackPanel>
                            <ComboBox app:HelpTip.Key="profiles.input" ItemsSource="{Binding InputOptions}" DisplayMemberPath="Name" SelectedValuePath="Type" HorizontalAlignment="Stretch"
                                      SelectedValue="{Binding SelectedProfile.InputType, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="{app:T Zh=輸入手把, En='Input controller'}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Label}" Text="{app:T Zh=輸出成, En='Output as'}"/>
                                <app:HelpTip Key="profiles.output"/>
                            </StackPanel>
                            <ComboBox app:HelpTip.Key="profiles.output" ItemsSource="{Binding OutputOptions}" DisplayMemberPath="Name" SelectedValuePath="Type" HorizontalAlignment="Stretch"
                                      SelectedValue="{Binding SelectedProfile.OutputType, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="{app:T Zh=輸出成, En='Output as'}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Switches -->
                <Border Style="{StaticResource Card}" Padding="16,6" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{app:T Zh=對調 A/B 與 X/Y, En='Swap A/B and X/Y'}"/>
                                <app:HelpTip Key="profiles.swap"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding SelectedProfile.SwapFaceButtons}" app:HelpTip.Key="profiles.swap"
                                             AutomationProperties.Name="{app:T Zh=對調 A/B 與 X/Y, En='Swap A/B and X/Y'}"/>
                        </Grid>
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{app:T Zh=隱藏實體手把（需 HidHide）, En='Hide physical controllers (needs HidHide)'}"/>
                                <app:HelpTip Key="profiles.hide"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding SelectedProfile.HidePhysicalControllers}" app:HelpTip.Key="profiles.hide"
                                             AutomationProperties.Name="{app:T Zh=隱藏實體手把, En='Hide physical controllers'}"/>
                        </Grid>
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{app:T Zh=把遊戲震動轉給實體手把, En='Forward game rumble to the physical controller'}"/>
                                <app:HelpTip Key="profiles.rumble"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding SelectedProfile.ForwardRumble}" app:HelpTip.Key="profiles.rumble"
                                             AutomationProperties.Name="{app:T Zh=轉發震動, En='Forward rumble'}"/>
                        </Grid>
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{app:T Zh='Xbox 的 View（Back）鍵當作觸控板按下', En='Use the Xbox View (Back) button as the touchpad click'}"/>
                                <app:HelpTip Key="profiles.touchpad"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding SelectedProfile.XboxBackAsTouchpad}" app:HelpTip.Key="profiles.touchpad"
                                             AutomationProperties.Name="{app:T Zh=Xbox 的 View 鍵當作觸控板, En='Xbox View button as touchpad'}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Sliders -->
                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Label}" Text="{app:T Zh='搖桿死區（0–0.95）', En='Stick dead zone (0–0.95)'}"/>
                                <app:HelpTip Key="profiles.deadzone"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Margin="12,4,0,4" Text="{Binding SelectedProfile.DeadZone, StringFormat=F2}"/>
                        </Grid>
                        <Slider app:HelpTip.Key="profiles.deadzone" Margin="0,0,0,10" Minimum="0" Maximum="0.95" TickFrequency="0.01" IsSnapToTickEnabled="True"
                                Value="{Binding SelectedProfile.DeadZone}" AutomationProperties.Name="{app:T Zh=搖桿死區, En='Dead zone'}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Label}" Text="{app:T Zh='目標輪詢頻率（30–500 Hz）', En='Target polling rate (30–500 Hz)'}"/>
                                <app:HelpTip Key="profiles.polling"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Margin="12,4,0,4" Text="{Binding SelectedProfile.PollingRateHz, StringFormat='{}{0} Hz'}"/>
                        </Grid>
                        <Slider app:HelpTip.Key="profiles.polling" Minimum="30" Maximum="500" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding SelectedProfile.PollingRateHz}" AutomationProperties.Name="{app:T Zh=輪詢頻率, En='Polling rate'}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Link rows -->
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button app:HelpTip.Key="profiles.calibrate" Command="{Binding CalibrateCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent" Padding="16,10"
                            AutomationProperties.Name="{app:T Zh='校準 NS2 Pro 搖桿', En='Calibrate NS2 Pro sticks'}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{app:T Zh='校準 NS2 Pro 搖桿', En='Calibrate NS2 Pro sticks'}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="{app:T Zh='推到底卻只像輕推、或放開時會飄移時使用；映射中也可以校準，儲存後立即套用。', En='Use this if a full push feels like a light one or the stick drifts at rest. Works while mapping; applies as soon as you save.'}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="›" FontSize="18" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                        <app:HelpTip Key="profiles.calibrate" Grid.Column="1" Margin="0,0,16,0"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button app:HelpTip.Key="profiles.test" Command="{Binding OpenControllerTestCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent" Padding="16,10"
                            AutomationProperties.Name="{app:T Zh='手把測試與報告匯出', En='Controller test and report export'}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{app:T Zh='手把測試與報告匯出', En='Controller test and report export'}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="{app:T Zh='查看手把的即時輸入，並匯出診斷報告。', En='See live controller input and export a diagnostic report.'}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="›" FontSize="18" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                        <app:HelpTip Key="profiles.test" Grid.Column="1" Margin="0,0,16,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
