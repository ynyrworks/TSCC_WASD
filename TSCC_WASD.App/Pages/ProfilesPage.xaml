<Page x:Class="TSCC_WASD.App.Pages.ProfilesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:app="clr-namespace:TSCC_WASD.App"
      Title="{app:T Zh=設定檔, En='Profiles'}" Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Shell.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <app:ProfileSubtitleConverter x:Key="ProfileSubtitle"/>
        </ResourceDictionary>
    </Page.Resources>
    <!-- No ScrollViewer here: the navigation view's content presenter scrolls the whole page (list and editor together). -->
    <Grid Margin="24,8,24,24">
        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*" MinWidth="320"/></Grid.ColumnDefinitions>

        <!-- Left: the profile list -->
        <StackPanel>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource PageTitle}" Margin="0" VerticalAlignment="Center" Text="{app:T Zh=設定檔, En='Profiles'}"/>
                <Button Grid.Column="1" Margin="0,0,6,0" Content="{app:T Zh=新增, En=New}" Command="{Binding NewCommand}"
                        ToolTip="{app:T Zh=新增設定檔, En='New profile'}"/>
                <ui:DropDownButton Grid.Column="2" DataContextChanged="OnMoreActionsDataContextChanged" Content="⋯"
                                   AutomationProperties.Name="{app:T Zh='更多：移除、複製、匯入、匯出、重新載入、設定資料夾', En='More: remove, duplicate, import, export, reload, settings folder'}">
                    <ui:DropDownButton.Flyout>
                        <ContextMenu x:Name="MoreActionsMenu">
                            <MenuItem Header="{app:T Zh=移除, En=Remove}" Command="{Binding DeleteCommand}"/>
                            <MenuItem Header="{app:T Zh=複製, En=Duplicate}" Command="{Binding DuplicateCommand}"/>
                            <Separator/>
                            <MenuItem Header="{app:T Zh=匯入, En=Import}" Command="{Binding ImportCommand}"/>
                            <MenuItem Header="{app:T Zh=匯出全部, En='Export all'}" Command="{Binding ExportCommand}"/>
                            <Separator/>
                            <MenuItem Header="{app:T Zh=從磁碟重新載入, En='Reload from disk'}" Command="{Binding ReloadCommand}"
                                      ToolTip="{app:T Zh='先儲存待寫入的修改，再從 profiles.json 重新讀取', En='Saves pending edits first, then re-reads profiles.json'}"/>
                            <MenuItem Header="{app:T Zh=開啟設定資料夾, En='Open settings folder'}" Command="{Binding OpenProfilesCommand}"/>
                        </ContextMenu>
                    </ui:DropDownButton.Flyout>
                </ui:DropDownButton>
            </Grid>
            <!-- The list never scrolls on its own; the page does. -->
            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" IsEnabled="{Binding CanEdit}"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent"
                     AutomationProperties.Name="{app:T Zh=設定檔, En=Profiles}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,6">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource ProfileSubtitle}">
                                        <Binding Path="MatchProcessName"/>
                                        <Binding/>
                                        <Binding Path="DataContext.SelectedProfile" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                        <Binding Path="DataContext.IsRunning" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <!-- Right: the selected profile -->
        <StackPanel Grid.Column="2">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedProfile}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding SelectedProfile.Name}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                           Text="{Binding SaveStatusText}" AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SaveStatusIsSaved}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SaveStatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <StackPanel IsEnabled="{Binding CanEdit}">
                <!-- Identity and devices -->
                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource Label}" Text="{app:T Zh=設定檔名稱, En='Profile name'}"/>
                            <TextBox Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                                     AutomationProperties.Name="{app:T Zh=設定檔名稱, En='Profile name'}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource Label}" Text="{app:T Zh=說明, En=Description}"/>
                            <TextBox Text="{Binding SelectedProfile.Description, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{app:T Zh=設定檔說明, En='Profile description'}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Label}" Text="{app:T Zh=遊戲程序, En='Game process'}"/>
                                <TextBlock Style="{StaticResource HelpMark}">
                                    <TextBlock.ToolTip>
                                        <ToolTip MaxWidth="340"><TextBlock TextWrapping="Wrap" Text="{app:T Zh='映射中遊戲到前景時自動切換到此設定檔，遊戲結束後切回。名稱不分大小寫，.exe 可有可無；留空則不使用。', En='While mapping, this profile is applied when the game comes to the foreground and switched back when it exits. The name is case-insensitive and .exe is optional; leave empty to disable.'}"/></ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="{app:T Zh=挑選…, En='Pick…'}"
                                        ToolTip="{app:T Zh=從執行中的程式挑選, En='Pick from running programs'}" Command="{Binding PickProcessCommand}"/>
                                <TextBox Text="{Binding SelectedProfile.MatchProcessName, UpdateSourceTrigger=PropertyChanged}" MaxLength="260"
                                         AutomationProperties.Name="{app:T Zh=遊戲程序名稱, En='Game process name'}"/>
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource Label}" Text="{app:T Zh=輸入手把, En='Input controller'}"/>
                            <ComboBox ItemsSource="{Binding InputOptions}" DisplayMemberPath="Name" SelectedValuePath="Type" HorizontalAlignment="Stretch"
                                      SelectedValue="{Binding SelectedProfile.InputType, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="{app:T Zh=輸入手把, En='Input controller'}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Label}" Text="{app:T Zh=輸出成, En='Output as'}"/>
                                <TextBlock Style="{StaticResource HelpMark}">
                                    <TextBlock.ToolTip>
                                        <ToolTip MaxWidth="340"><TextBlock TextWrapping="Wrap" Text="{app:T Zh='遊戲顯示哪種按鍵圖示取決於它看到的手把。Xbox 360 相容性最好；DualShock 4 才有 PS 圖示、PS 鍵、觸控板與體感。映射中切換會立即生效。', En='Games pick prompts from the controller they see. Xbox 360 is the most compatible; only DualShock 4 gives PS prompts, the PS button, touchpad and motion. Switching applies right away while mapping.'}"/></ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding OutputOptions}" DisplayMemberPath="Name" SelectedValuePath="Type" HorizontalAlignment="Stretch"
                                      SelectedValue="{Binding SelectedProfile.OutputType, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="{app:T Zh=輸出成, En='Output as'}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Switches -->
                <Border Style="{StaticResource Card}" Padding="16,6" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{app:T Zh=對調 A/B 與 X/Y, En='Swap A/B and X/Y'}"/>
                                <TextBlock Style="{StaticResource HelpMark}">
                                    <TextBlock.ToolTip>
                                        <ToolTip MaxWidth="340"><TextBlock TextWrapping="Wrap" Text="{app:T Zh='任天堂習慣：右邊的鍵是確認。勾選後右側鍵送出 ✕／Xbox A、下方鍵送出 ○／Xbox B。NS2 Pro 也會改成依按鍵上的字母對應，而不是位置。', En='Nintendo habit: the right-hand button confirms. The right-hand button then sends Cross / Xbox A and the bottom one Circle / Xbox B. The NS2 Pro then follows the letters printed on its buttons instead of their positions.'}"/></ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding SelectedProfile.SwapFaceButtons}"
                                             AutomationProperties.Name="{app:T Zh=對調 A/B 與 X/Y, En='Swap A/B and X/Y'}"/>
                        </Grid>
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{app:T Zh=隱藏實體手把（需 HidHide）, En='Hide physical controllers (needs HidHide)'}"/>
                                <TextBlock Style="{StaticResource HelpMark}">
                                    <TextBlock.ToolTip>
                                        <ToolTip MaxWidth="340"><TextBlock TextWrapping="Wrap" Text="{app:T Zh='讓遊戲只看到虛擬手把，避免按鍵圖示在 Xbox／PS 之間跳動。請先啟動映射再開遊戲；停止映射後自動還原。', En='Games then only see the virtual controller, so prompts stop flipping between Xbox and PS. Start mapping before the game; stopping restores everything.'}"/></ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding SelectedProfile.HidePhysicalControllers}"
                                             AutomationProperties.Name="{app:T Zh=隱藏實體手把, En='Hide physical controllers'}"/>
                        </Grid>
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{app:T Zh=把遊戲震動轉給實體手把, En='Forward game rumble to the physical controller'}"/>
                                <TextBlock Style="{StaticResource HelpMark}">
                                    <TextBlock.ToolTip>
                                        <ToolTip MaxWidth="340"><TextBlock TextWrapping="Wrap" Text="{app:T Zh='Xbox 鍵與 NS2 Home 鍵對應 PS 鍵、NS2 截圖鍵對應觸控板按下；NS2 陀螺儀會轉成 DS4 體感。', En='Xbox Guide and NS2 Home map to PS, NS2 Capture to touchpad click, and the NS2 gyro becomes DS4 motion.'}"/></ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding SelectedProfile.ForwardRumble}"
                                             AutomationProperties.Name="{app:T Zh=轉發震動, En='Forward rumble'}"/>
                        </Grid>
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{app:T Zh='Xbox 的 View（Back）鍵當作觸控板按下', En='Use the Xbox View (Back) button as the touchpad click'}"/>
                                <TextBlock Style="{StaticResource HelpMark}">
                                    <TextBlock.ToolTip>
                                        <ToolTip MaxWidth="340"><TextBlock TextWrapping="Wrap" Text="{app:T Zh='PS 遊戲常用觸控板開地圖或選單。取消勾選則 View 鍵送出 Share；NS2 Pro 不受影響（－鍵是 Share、截圖鍵是觸控板）。', En='PS games often open the map or menu with the touchpad. Unchecked, View sends Share. The NS2 Pro is unaffected (Minus is Share, Capture is the touchpad).'}"/></ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding SelectedProfile.XboxBackAsTouchpad}"
                                             AutomationProperties.Name="{app:T Zh=Xbox 的 View 鍵當作觸控板, En='Xbox View button as touchpad'}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Sliders -->
                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="{app:T Zh='搖桿死區（0–0.95）', En='Stick dead zone (0–0.95)'}"/>
                            <TextBlock Grid.Column="1" Margin="12,4,0,4" Text="{Binding SelectedProfile.DeadZone, StringFormat=F2}"/>
                        </Grid>
                        <Slider Margin="0,0,0,10" Minimum="0" Maximum="0.95" TickFrequency="0.01" IsSnapToTickEnabled="True"
                                Value="{Binding SelectedProfile.DeadZone}" AutomationProperties.Name="{app:T Zh=搖桿死區, En='Dead zone'}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="{app:T Zh='目標輪詢頻率（30–500 Hz）', En='Target polling rate (30–500 Hz)'}"/>
                            <TextBlock Grid.Column="1" Margin="12,4,0,4" Text="{Binding SelectedProfile.PollingRateHz, StringFormat='{}{0} Hz'}"/>
                        </Grid>
                        <Slider Minimum="30" Maximum="500" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding SelectedProfile.PollingRateHz}" AutomationProperties.Name="{app:T Zh=輪詢頻率, En='Polling rate'}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Link rows -->
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
                <StackPanel>
                    <Button Command="{Binding CalibrateCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent" Padding="16,10"
                            AutomationProperties.Name="{app:T Zh='校準 NS2 Pro 搖桿', En='Calibrate NS2 Pro sticks'}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{app:T Zh='校準 NS2 Pro 搖桿', En='Calibrate NS2 Pro sticks'}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="{app:T Zh='推到底卻只像輕推、或放開時會飄移時使用；映射中也可以校準，儲存後立即套用。', En='Use this if a full push feels like a light one or the stick drifts at rest. Works while mapping; applies as soon as you save.'}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="›" FontSize="18" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Command="{Binding OpenControllerTestCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent" Padding="16,10"
                            AutomationProperties.Name="{app:T Zh='手把測試與報告匯出', En='Controller test and report export'}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{app:T Zh='手把測試與報告匯出', En='Controller test and report export'}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="{app:T Zh='查看手把的即時輸入，並匯出診斷報告。', En='See live controller input and export a diagnostic report.'}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="›" FontSize="18" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
