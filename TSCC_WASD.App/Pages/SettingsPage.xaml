<Page x:Class="TSCC_WASD.App.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:app="clr-namespace:TSCC_WASD.App"
      Title="{app:T Zh=程式設定, En='App settings'}" Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <ResourceDictionary Source="../Themes/Shell.xaml"/>
    </Page.Resources>
    <!-- No ScrollViewer here: the navigation view's content presenter already scrolls the page. -->
    <StackPanel Margin="24,8,24,24">
        <TextBlock Style="{StaticResource PageTitle}" Margin="0,0,0,8" Text="{app:T Zh=程式設定, En='App settings'}"/>
        <TextBlock Style="{StaticResource Label}" FontWeight="SemiBold" Margin="2,4,0,4" Text="{app:T Zh='開機與 Steam', En='Start-up and Steam'}"/>
        <Border Style="{StaticResource Card}" Padding="16,2" Margin="0,0,0,8">
            <StackPanel>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{app:T Zh='登入 Windows 時', En='When signing in to Windows'}" TextWrapping="Wrap"/>
                                <app:HelpTip Key="settings.startup"/>
                            </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding StartupDescription}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="260" ItemsSource="{Binding StartupOptions}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding StartupChoice}" app:HelpTip.Key="settings.startup" AutomationProperties.Name="{app:T Zh='登入 Windows 時', En='When signing in to Windows'}"/>
                    </Grid>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{app:T Zh='自動開始映射時的 Steam', En='Steam on automatic start'}" TextWrapping="Wrap"/>
                                <app:HelpTip Key="settings.steam"/>
                            </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Text="{app:T Zh='只在登入或開啟程式而自動開始映射時套用；手動按「開始」時請改用「重新啟動 Steam」按鈕。', En='Applies only when mapping starts automatically (at sign-in or when the app opens). When you press Start by hand, use the Restart Steam button instead.'}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="260" ItemsSource="{Binding SteamOptions}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding SteamChoice}" app:HelpTip.Key="settings.steam" AutomationProperties.Name="{app:T Zh='自動開始映射時的 Steam', En='Steam on automatic start'}"/>
                    </Grid>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{app:T Zh='自動重新連接（不必重啟 Steam）', En='Automatic reconnect (no Steam restart)'}" TextWrapping="Wrap"/>
                                <app:HelpTip Key="settings.reconnect"/>
                            </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding ReconnectHelperStatus}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Margin="0,0,8,0" app:HelpTip.Key="settings.reconnect" Content="{app:T Zh=設定, En='Set up'}" Command="{Binding SetupReconnectCommand}"
                                    AutomationProperties.Name="{app:T Zh=設定自動重新連接, En='Set up automatic reconnect'}"/>
                            <Button app:HelpTip.Key="settings.reconnect" Content="{app:T Zh=移除, En=Remove}" Command="{Binding RemoveReconnectCommand}"
                                    AutomationProperties.Name="{app:T Zh=移除自動重新連接, En='Remove automatic reconnect'}"/>
                        </StackPanel>
                    </Grid>
            </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource Label}" FontWeight="SemiBold" Margin="2,4,0,4" Text="{app:T Zh='驅動程式與隱藏', En='Drivers and hiding'}"/>
        <Border Style="{StaticResource Card}" Padding="16,2" Margin="0,0,0,8">
            <StackPanel>
                    <Grid x:Name="DriversRow" Margin="0,5">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{app:T Zh='ViGEmBus 與 HidHide', En='ViGEmBus and HidHide'}" TextWrapping="Wrap"/>
                                <app:HelpTip Key="settings.drivers"/>
                            </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding DriverSummary}"/>
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Center" app:HelpTip.Key="settings.drivers" Content="{app:T Zh=安裝驅動程式, En='Install drivers'}" Command="{Binding InstallDepsCommand}"/>
                    </Grid>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{app:T Zh='也隱藏第三方 XInput 手把', En='Also hide third-party XInput controllers'}" TextWrapping="Wrap"/>
                                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Muted}" Text="{app:T Zh=實驗性, En=Experimental}"/>
                                </Border>
                                <app:HelpTip Key="settings.thirdparty"/>
                            </StackPanel>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding HideThirdPartyXInput}" app:HelpTip.Key="settings.thirdparty" AutomationProperties.Name="{app:T Zh='也隱藏第三方 XInput 手把', En='Also hide third-party XInput controllers'}"/>
                    </Grid>
            </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource Label}" FontWeight="SemiBold" Margin="2,4,0,4" Text="{app:T Zh='外觀與更新', En='Appearance and updates'}"/>
        <Border Style="{StaticResource Card}" Padding="16,2" Margin="0,0,0,8">
            <StackPanel>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{app:T Zh='最小化時縮到系統匣', En='Minimize to the notification area'}" TextWrapping="Wrap"/>
                                <app:HelpTip Key="settings.tray"/>
                            </StackPanel>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding MinimizeToTray}" app:HelpTip.Key="settings.tray" AutomationProperties.Name="{app:T Zh='最小化時縮到系統匣', En='Minimize to the notification area'}"/>
                    </Grid>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{app:T Zh='開啟程式時檢查更新', En='Check for updates when the app opens'}" TextWrapping="Wrap"/>
                                <app:HelpTip Key="settings.updates"/>
                            </StackPanel>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding CheckUpdatesOnStartup}" app:HelpTip.Key="settings.updates" AutomationProperties.Name="{app:T Zh='開啟程式時檢查更新', En='Check for updates when the app opens'}"/>
                    </Grid>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{app:T Zh='語言', En='Language'}" TextWrapping="Wrap"/>
                                <app:HelpTip Key="settings.language"/>
                            </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Text="{app:T Zh='重新開啟後套用', En='Applies after restart'}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="260" ItemsSource="{Binding LanguageOptions}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding Language}" app:HelpTip.Key="settings.language" AutomationProperties.Name="{app:T Zh=語言, En=Language}"/>
                    </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
