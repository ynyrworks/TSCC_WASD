<Page x:Class="TSCC_WASD.App.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:app="clr-namespace:TSCC_WASD.App"
      Title="{app:T Zh=首頁, En='Home'}" Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <ResourceDictionary Source="../Themes/Shell.xaml"/>
    </Page.Resources>
    <!-- No ScrollViewer here: the navigation view's content presenter already scrolls the page. -->
        <StackPanel Margin="24,8,24,24">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Image Source="/TSCC_WASD;component/Assets/TSCC_WASD_256.png" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="TSCC_WASD" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="8,0,0,4"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" FontSize="13"
                               Text="{app:T Zh='把 Xbox／NS2 Pro 手把變成 DualShock 4，讓遊戲顯示 PS 按鍵', En='Turns an Xbox or NS2 Pro controller into a DualShock 4 so games show PS prompts'}"/>
                </StackPanel>
            </Grid>
            <!-- 1. Controller card -->
            <Border x:Name="ControllerCard" Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse Width="12" Height="12" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource TextFillColorDisabledBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusLine}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <app:HelpTip Key="home.controller"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ControllerName}" TextWrapping="Wrap" Margin="22,0,0,2"/>
                        <!-- Stick calibration status goes here once the calibration branch lands. -->
                        <!-- Live input summary (buttons, sticks); only while mapping runs. -->
                        <TextBlock x:Name="InputSummaryText" Text="{Binding InputSummary}" ToolTip="{Binding InputSummary}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="22,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" Margin="22,4,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="MainActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <ui:Button Appearance="Primary" MinWidth="130" Height="44" FontSize="16" Margin="0"
                                   Content="{Binding MainButtonText}" Command="{Binding MainCommand}" app:HelpTip.Key="home.main"/>
                        <app:HelpTip Key="home.main" Margin="2,0,8,0"/>
                        <ui:DropDownButton Height="44" app:HelpTip.Key="home.more" DataContextChanged="OnMoreActionsDataContextChanged" Content="▾" AutomationProperties.Name="{app:T Zh=更多動作, En='More actions'}">
                            <ui:DropDownButton.Flyout>
                                <ContextMenu x:Name="MoreActionsMenu">
                                    <MenuItem Command="{Binding PauseCommand}" app:HelpTip.Key="home.pause" AutomationProperties.Name="{Binding PauseButtonText}">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding PauseButtonText}"/><app:HelpTip Key="home.pause" Focusable="False"/></StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem Command="{Binding StopCommand}" app:HelpTip.Key="home.stop" AutomationProperties.Name="{app:T Zh='完全釋放（停止）', En='Release everything (Stop)'}">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="{app:T Zh='完全釋放（停止）', En='Release everything (Stop)'}"/><app:HelpTip Key="home.stop" Focusable="False"/></StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem Command="{Binding InstallDepsCommand}" app:HelpTip.Key="home.install" AutomationProperties.Name="{app:T Zh=安裝驅動程式, En='Install drivers'}">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="{app:T Zh=安裝驅動程式, En='Install drivers'}"/><app:HelpTip Key="home.install" Focusable="False"/></StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                </ContextMenu>
                            </ui:DropDownButton.Flyout>
                        </ui:DropDownButton>
                        <app:HelpTip Key="home.more" Margin="2,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Three small cards -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border x:Name="OutputCard" Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Muted}" Text="{app:T Zh=遊戲看到的手把, En='Controller games see'}"/>
                            <app:HelpTip Key="home.output"/>
                        </StackPanel>
                        <TextBlock Text="{Binding OutputTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,2"/>
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding OutputDetail}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Muted}" Text="{app:T Zh=設定檔, En=Profile}"/>
                            <app:HelpTip Key="home.profile"/>
                        </StackPanel>
                        <ComboBox app:HelpTip.Key="home.profile" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name"
                                  IsEnabled="{Binding CanEdit}" Margin="0,4,0,4"
                                  AutomationProperties.Name="{app:T Zh=設定檔, En=Profile}"/>
                        <TextBlock Style="{StaticResource Muted}" Text="{app:T Zh=遊戲在前景時自動切換, En='Switches automatically when a game is in front'}">
                            <TextBlock.Visibility>
                                <Binding Path="AutoSwitchApplies">
                                    <Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter>
                                </Binding>
                            </TextBlock.Visibility>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border x:Name="SteamCard" Grid.Column="4" Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Muted}" Text="Steam"/>
                            <app:HelpTip Key="home.steam"/>
                        </StackPanel>
                        <Button Margin="0,4,0,4" Content="{app:T Zh='重新啟動 Steam', En='Restart Steam'}" Command="{Binding RestartSteamCommand}"
                                app:HelpTip.Key="home.steam"/>
                        <TextBlock Style="{StaticResource Muted}" Text="{app:T Zh=讓 Steam 只看到虛擬手把, En='Steam then sees only the virtual controller'}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. Common switches: the same profile properties as the Profiles page. -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18,8">
                <StackPanel IsEnabled="{Binding CanEdit}">
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{app:T Zh=隱藏實體手把（需 HidHide）, En='Hide physical controllers (needs HidHide)'}"/>
                            <app:HelpTip Key="home.hide"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding SelectedProfile.HidePhysicalControllers}" app:HelpTip.Key="home.hide"
                                         AutomationProperties.Name="{app:T Zh=隱藏實體手把, En='Hide physical controllers'}"/>
                    </Grid>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{app:T Zh=把遊戲震動轉給實體手把, En='Forward game rumble to the controller'}"/>
                            <app:HelpTip Key="home.rumble"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding SelectedProfile.ForwardRumble}" app:HelpTip.Key="home.rumble"
                                         AutomationProperties.Name="{app:T Zh=轉發震動, En='Forward rumble'}"/>
                    </Grid>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{app:T Zh=對調 A/B 與 X/Y, En='Swap A/B and X/Y'}"/>
                            <app:HelpTip Key="home.swap"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding SelectedProfile.SwapFaceButtons}" app:HelpTip.Key="home.swap"
                                         AutomationProperties.Name="{app:T Zh=對調 A/B 與 X/Y, En='Swap A/B and X/Y'}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Update download progress; only shown while an update downloads. -->
            <Grid Margin="0,0,0,8">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDownloadingUpdate}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding UpdateProgressText}" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                    <ProgressBar Value="{Binding UpdateProgress, Mode=OneWay}" Minimum="0" Maximum="1" Height="6"
                                 AutomationProperties.Name="{app:T Zh=更新下載進度, En='Update download progress'}"/>
                </StackPanel>
                <Button x:Name="CancelUpdateButton" Grid.Column="1" Content="{app:T Zh=取消, En=Cancel}" Command="{Binding CancelUpdateCommand}"
                        Margin="12,0,0,0" VerticalAlignment="Center"/>
            </Grid>

            <!-- 4. Footer -->
            <TextBlock Text="{Binding FooterText}" Style="{StaticResource Muted}" Margin="2,0,0,2"/>
            <TextBlock Text="{Binding DependencyStatus}" Style="{StaticResource Muted}" Margin="2,0,0,0"/>
        </StackPanel>
</Page>
